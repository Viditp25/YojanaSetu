# Copy this file to `.env` and fill in at least one API key for LLM NL-to-SQL & Audio STT.
# If no API key is set, YojanaSetu Voice automatically uses its offline multilingual keyword + fuzzy fallback.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional override: auto (default), gemini, openai, or fallback
LLM_PROVIDER=auto
